# Copy to .env. Existing server/.env is also supported.
# Use your SAP Business Accelerator Hub sandbox API key (never put it in app.js).
SAP_API_KEY=your_sap_api_key_here
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata4/sap/api_salesorder/srvd_a2x/sap/salesorder/0001
# Optional override: full SalesOrderItem collection URL, including any query parameters.
# SAP_ITEMS_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata4/sap/api_salesorder/srvd_a2x/sap/salesorder/0001/SalesOrderItem
# Initial order list pages. Each selected order's full items are fetched separately.
SAP_MAX_PAGES=1
PORT=3000
